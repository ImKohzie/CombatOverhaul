local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("ApexCity").Config.GameConfig)

local Controllers = script.Parent.Controllers

-- One failing controller must never stop the rest of the client.
local function safeInit(name: string, init: () -> ())
	local ok, err = pcall(init :: any)
	if not ok then
		warn(string.format("[APEX CITY] client %s failed to start: %s", name, tostring(err)))
	end
end

